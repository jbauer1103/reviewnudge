# Copy this file to a new file called .env (in this same folder) and fill in your values.
# .env is never uploaded to GitHub.
#
# Both values are on your Supabase project page: click "Connect" at the top,
# or go to Project Settings > API Keys.
# Use the PUBLISHABLE key (starts with sb_publishable_). NEVER put the secret key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
